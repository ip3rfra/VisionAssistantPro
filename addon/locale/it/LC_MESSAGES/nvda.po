#, python-brace-format
msgid "Timed out while waiting for {operation}."
msgstr "Tempo scaduto durante l'attesa di {operation}."

#. Translators: Error message shown when saved credentials lack Google Cloud permission.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:258
msgid "Google Cloud permission was not granted. Please click Sign In again and check the Google Cloud checkbox."
msgstr "L'autorizzazione a Google Cloud non è stata concessa. Fare nuovamente clic su Accedi e selezionare la casella di controllo Google Cloud."

#. Translators: Error message shown when the user is not signed in to Google Cloud.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:280
msgid "You are not signed in to Google Cloud. Use the Sign In button first."
msgstr "Non hai effettuato l'accesso a Google Cloud. Usa prima il pulsante Accedi."

#. Translators: Title and heading of the web page shown in the browser after successful Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:324
msgid "Authentication Successful"
msgstr "Autenticazione riuscita"

#. Translators: Message shown in the browser after successful Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:326
msgid "Authentication successful! You can now close this browser tab and return to NVDA."
msgstr "Autenticazione riuscita! Ora puoi chiudere questa scheda del browser e tornare a NVDA."

#. Translators: Title and heading of the web page shown in the browser when Google sign-in fails.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:338
msgid "Sign-in Failed"
msgstr "Accesso non riuscito"

#. Translators: Status message shown when the Google sign-in process starts and a browser window will open.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:350
