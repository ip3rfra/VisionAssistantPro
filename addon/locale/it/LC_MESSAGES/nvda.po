#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:447
msgid "No access token returned by Google."
msgstr "Nessun token di accesso restituito da Google."

#. Translators: Error message shown when Google Cloud permission was not consented on Google sign-in.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:453
msgid "Google Cloud permission was not granted. Please sign in again and ensure the Google Cloud checkbox is ticked on the Google consent page."
msgstr "L'autorizzazione per Google Cloud non è stata concessa. Effettua nuovamente l'accesso e assicurati che la casella di controllo di Google Cloud sia selezionata nella pagina di consenso di Google."

#. Translators: Status message shown when the Google sign-in completed successfully.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:475
msgid "Signed in successfully."
msgstr "Accesso effettuato con successo."

#. Translators: Status message shown when the stored Google credentials are removed.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:481
msgid "Removing the stored Google credentials..."
msgstr "Rimozione delle credenziali Google memorizzate..."

#. Translators: Status message shown when signed out successfully.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:517
msgid "Signed out successfully."
msgstr "Disconnessione effettuata con successo."

#. Translators: Status message shown while creating a Google Cloud project.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:641
msgid "Creating the project..."
msgstr "Creazione del progetto in corso..."

#. Translators: Name of the Google Cloud operation that creates a project, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:653
msgid "project creation"
msgstr "creazione del progetto"

#. Translators: Status message shown while enabling a Google API on a project.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:661
msgid "Enabling an API..."
msgstr "Abilitazione di un'API in corso..."

#. Translators: Status message shown while retrying to enable a Google API, {seconds} is the delay in seconds.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:666
#, python-brace-format
msgid "Retrying in {seconds} seconds..."
msgstr "Nuovo tentativo tra {seconds} secondi..."

#. Translators: Name of the Google Cloud operation that enables an API, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:684
msgid "enabling the API"
msgstr "abilitazione dell'API"

#. Translators: Status message shown while creating a Gemini API key.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:713
msgid "Creating the API key..."
msgstr "Creazione della chiave API in corso..."

#. Translators: Name of the Google Cloud operation that creates an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:734
msgid "API key creation"
msgstr "creazione della chiave API"

#. Translators: Name of the Google Cloud operation that deletes an API key, shown if it times out.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:749
msgid "API key deletion"
msgstr "eliminazione della chiave API"

#. Translators: Column header for API key value in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:796
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:806
msgid "Key"
msgstr "Chiave"

#. Translators: Column header for project name in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:802
msgid "Project"
msgstr "Progetto"

#. Translators: Column header for key label in exported Gemini API keys CSV file.
#: addon\globalPlugins\visionAssistant\features\gemini_keys.py:804
msgid "Name"
msgstr "Nome"

#. Translators: Line appended to the conversation when the live session has ended.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:75
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:76
msgid "--- Session ended ---"
msgstr "--- sessione terminata ---"

#. Translators: Message announced by NVDA when the live voice conversation ends.
#: addon\globalPlugins\visionAssistant\features\live_assistant.py:103
msgid "Live conversation ended."
msgstr "Conversazione dal vivo terminata"

